local function log(...)
    if CONFIG.Debug then
        print("[ControllerBridge]", ...)
    end
end

local function getVirtualInputManager()
    local ok, service = pcall(function()
        return game:GetService("VirtualInputManager")
    end)
    if ok and service then
        return service
    end
    return nil
end

local function sendKeyEvent(keyCode, isDown)
    local virtualInput = getVirtualInputManager()
    if not virtualInput then
        return false
    end
    return pcall(function()
        virtualInput:SendKeyEvent(isDown, keyCode, false, game)
    end)
end

local function pressKeyboardKey(keyCode)
    local downOk = sendKeyEvent(keyCode, true)
    task.wait(0.035)
    local upOk = sendKeyEvent(keyCode, false)
    return downOk and upOk
end

local function getCharacter()
    return LocalPlayer.Character
end

local function getHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function getBackpack()
    return LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
end

local function cleanStick(raw, deadzone)
    local magnitude = raw.Magnitude
    if magnitude <= deadzone then
        return Vector2.zero
    end
    local scaled = (magnitude - deadzone) / math.max(1 - deadzone, 0.001)
    return raw.Unit * math.clamp(scaled, 0, 1)
end

local function collectTools()
    local tools = {}
    local character = getCharacter()
    local backpack = getBackpack()

    local function addFrom(container)
        if not container then
            return
        end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool") then
                table.insert(tools, child)
            end
        end
    end

    addFrom(character)
    addFrom(backpack)

    table.sort(tools, function(a, b)
        local slotA = tonumber(a:GetAttribute("Slot") or a:GetAttribute("HotbarSlot") or a:GetAttribute("BackpackSlot") or a:GetAttribute("SlotNumber"))
        local slotB = tonumber(b:GetAttribute("Slot") or b:GetAttribute("HotbarSlot") or b:GetAttribute("BackpackSlot") or b:GetAttribute("SlotNumber"))
        if slotA and slotB and slotA ~= slotB then
            return slotA < slotB
        end
        if slotA and not slotB then
            return true
        end
        if slotB and not slotA then
            return false
        end
        return a.Name < b.Name
    end)

    return tools
end

local function getEquippedToolIndex(tools)
    local character = getCharacter()
    if not character then
        return nil
    end
    for index, tool in ipairs(tools) do
        if tool.Parent == character then
            return index
        end
    end
    return nil
end

local function equipToolByDirection(direction)
    local now = os.clock()
    if now - state.lastEquip < CONFIG.EquipCooldown then
        return
    end
    state.lastEquip = now

    local character = getCharacter()
    local humanoid = getHumanoid(character)
    if not humanoid then
        return
    end

    local tools = collectTools()
    if #tools == 0 then
        return
    end

    local currentIndex = getEquippedToolIndex(tools)
    local nextIndex
    if currentIndex then
        nextIndex = ((currentIndex - 1 + direction) % #tools) + 1
    else
        nextIndex = direction >= 0 and 1 or #tools
    end

    local nextTool = tools[nextIndex]
    if nextTool then
        pcall(function()
            humanoid:EquipTool(nextTool)
        end)
        log(direction > 0 and "Next item:" or "Previous item:", nextTool.Name)
    end
end

local function configurePrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") then
        pcall(function()
            prompt.GamepadKeyCode = CONFIG.PromptInteractButton
        end)
    end
end

local function configureExistingPrompts()
    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            configurePrompt(descendant)
        end
    end
end

local function setControlActive(name, active)
    local control = state.overlay.controls[name]
    if not control then
        return
    end
    local color = active and Color3.fromRGB(215, 218, 224) or control.BaseColor
    local textColor = active and Color3.fromRGB(20, 22, 26) or Color3.fromRGB(190, 196, 208)
    for _, object in ipairs(control.Objects) do
        if object and object.Parent then
            if object:IsA("GuiObject") then
                object.BackgroundColor3 = color
            end
            if object:IsA("TextLabel") or object:IsA("TextButton") then
                object.TextColor3 = textColor
            end
        end
    end
end

local function refreshOverlayStates()
    if state.overlay.closed then
        return
    end

    setControlActive("Circle", state.gamepadDown[CONFIG.InteractButton] == true or state.interactHeld)
    setControlActive("Square", state.gamepadDown[CONFIG.ReloadButton] == true)
    setControlActive("Triangle", state.gamepadDown[CONFIG.BackquoteButton] == true)
    setControlActive("Cross", state.gamepadDown[CONFIG.JumpButton] == true)
    setControlActive("L1", state.gamepadDown[CONFIG.PreviousItemButton] == true)
    setControlActive("R1", state.gamepadDown[CONFIG.NextItemButton] == true)
    setControlActive("L3", state.gamepadDown[CONFIG.SprintButton] == true or state.sprintActive)
    setControlActive("R3", state.gamepadDown[CONFIG.CButton] == true)
    setControlActive("LeftStick", state.leftStick.Magnitude > 0)
    setControlActive("RightStick", state.rightStick.Magnitude > 0)
end

local function makeCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = radius or UDim.new(0, 8)
    corner.Parent = parent
    return corner
end

local function makeStroke(parent, color, transparency, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Color3.fromRGB(84, 88, 98)
    stroke.Transparency = transparency or 0.35
    stroke.Thickness = thickness or 1
    stroke.Parent = parent
    return stroke
end

local function registerControl(name, objects, baseColor)
    state.overlay.controls[name] = {
        Objects = objects,
        BaseColor = baseColor or Color3.fromRGB(58, 61, 69),
    }
end

