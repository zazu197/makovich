local function setInteractHeld(isHeld)
    if state.interactHeld == isHeld then
        return
    end

    state.interactHeld = isHeld
    refreshOverlayStates()
    local sent = sendKeyEvent(CONFIG.InteractKeyboardKey, isHeld)
    if sent then
        log(isHeld and "Circle/B holding E" or "Circle/B released E")
    elseif isHeld then
        log("Circle/B pressed. ProximityPrompts use Circle/B; direct E hold injection unavailable in this environment.")
    end
end

local function handleReload()
    local sent = pressKeyboardKey(CONFIG.ReloadKeyboardKey)
    if sent then
        log("Square/X -> R")
    else
        log("Square/X pressed. Direct R injection unavailable in this environment; final support should bind reload logic to ButtonX.")
    end
end

local function handleBackquoteAction()
    local sent = pressKeyboardKey(CONFIG.BackquoteKeyboardKey)
    if sent then
        log("Triangle/Y -> `")
    else
        log("Triangle/Y pressed. Direct backquote injection unavailable in this environment; final support should bind the related action to ButtonY.")
    end
end

local function handleJumpAction()
    local sent = pressKeyboardKey(CONFIG.JumpKeyboardKey)
    if sent then
        log("Cross/A -> Space")
    else
        log("Cross/A pressed. Direct Space injection unavailable in this environment; Roblox default controller jump should still work.")
    end
end

local function handleCAction()
    local sent = pressKeyboardKey(CONFIG.CKeyboardKey)
    if sent then
        log("R3 -> C")
    else
        log("R3 pressed. Direct C injection unavailable in this environment; final support should bind the C action to ButtonR3.")
    end
end

local function applyWalkSpeedSprint(active)
    if not CONFIG.EnableWalkSpeedFallback then
        return
    end

    local humanoid = getHumanoid(getCharacter())
    if not humanoid then
        return
    end

    if active then
        if not state.preSprintWalkSpeed then
            state.preSprintWalkSpeed = humanoid.WalkSpeed
        end
        local targetSpeed = math.max(state.preSprintWalkSpeed * CONFIG.SprintWalkSpeedMultiplier, CONFIG.MinimumSprintWalkSpeed)
        humanoid.WalkSpeed = targetSpeed
    else
        if state.preSprintWalkSpeed then
            humanoid.WalkSpeed = state.preSprintWalkSpeed
        end
        state.preSprintWalkSpeed = nil
    end
end

local function setSprint(active)
    if state.sprintActive == active then
        return
    end

    state.sprintActive = active
    sendKeyEvent(CONFIG.SprintKeyboardKey, active)
    applyWalkSpeedSprint(active)
    refreshOverlayStates()
    log(active and "Sprint enabled" or "Sprint disabled")
end

local function toggleSprint()
    setSprint(not state.sprintActive)
end

local function handleSprintInput(inputState)
    if CONFIG.SprintIsToggle then
        if inputState == Enum.UserInputState.Begin then
            toggleSprint()
        end
    else
        if inputState == Enum.UserInputState.Begin then
            setSprint(true)
        elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
            setSprint(false)
        end
    end
end

local function bindAction(name, callback, keyCode)
    ContextActionService:UnbindAction(name)
    ContextActionService:BindActionAtPriority(name, function(_, inputState, inputObject)
        if inputState ~= Enum.UserInputState.Begin then
            return Enum.ContextActionResult.Pass
        end
        callback(inputObject)
        return Enum.ContextActionResult.Sink
    end, false, CONFIG.ActionPriority, keyCode)
end

local function bindPassAction(name, callback, keyCode)
    ContextActionService:UnbindAction(name)
    ContextActionService:BindActionAtPriority(name, function(_, inputState, inputObject)
        if inputState == Enum.UserInputState.Begin then
            callback(inputObject)
        end
        return Enum.ContextActionResult.Pass
    end, false, CONFIG.ActionPriority, keyCode)
end

local function bindHoldAction(name, beginCallback, endCallback, keyCode)
    ContextActionService:UnbindAction(name)
    ContextActionService:BindActionAtPriority(name, function(_, inputState)
        if inputState == Enum.UserInputState.Begin then
            beginCallback()
            return Enum.ContextActionResult.Sink
        elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
            endCallback()
            return Enum.ContextActionResult.Sink
        end
        return Enum.ContextActionResult.Pass
    end, false, CONFIG.ActionPriority, keyCode)
end

local function bindSprintAction()
    local name = "ControllerBridge_Sprint"
    ContextActionService:UnbindAction(name)
    ContextActionService:BindActionAtPriority(name, function(_, inputState)
        handleSprintInput(inputState)
        return Enum.ContextActionResult.Sink
    end, false, CONFIG.ActionPriority, CONFIG.SprintButton)
end

bindHoldAction("ControllerBridge_InteractHold", function()
    setInteractHeld(true)
end, function()
    setInteractHeld(false)
end, CONFIG.InteractButton)
bindAction("ControllerBridge_Reload", handleReload, CONFIG.ReloadButton)
bindAction("ControllerBridge_BackquoteAction", handleBackquoteAction, CONFIG.BackquoteButton)
