UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Gamepad1 then
        return
    end
    state.gamepadDown[input.KeyCode] = true
    refreshOverlayStates()
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Gamepad1 then
        return
    end

    if input.KeyCode == Enum.KeyCode.Thumbstick1 then
        state.leftStick = cleanStick(Vector2.new(input.Position.X, input.Position.Y), CONFIG.LeftStickDeadzone)
        refreshOverlayStates()
    elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
        state.rightStick = cleanStick(Vector2.new(input.Position.X, input.Position.Y), CONFIG.RightStickDeadzone)
        refreshOverlayStates()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Gamepad1 then
        return
    end

    state.gamepadDown[input.KeyCode] = nil
    if input.KeyCode == Enum.KeyCode.Thumbstick1 then
        state.leftStick = Vector2.zero
    elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
        state.rightStick = Vector2.zero
    elseif input.KeyCode == CONFIG.InteractButton then
        setInteractHeld(false)
    end
    refreshOverlayStates()
end)

RunService:BindToRenderStep("ControllerBridge_CustomMovement", Enum.RenderPriority.Input.Value + 1, function()
    if not CONFIG.EnableCustomLeftStickMovement then
        return
    end

    local stick = state.leftStick
    if stick.Magnitude <= 0 then
        return
    end

    local camera = Workspace.CurrentCamera
    local character = getCharacter()
    local humanoid = getHumanoid(character)
    if not camera or not humanoid then
        return
    end

    local look = camera.CFrame.LookVector
    local right = camera.CFrame.RightVector
    local forward = Vector3.new(look.X, 0, look.Z)
    local rightFlat = Vector3.new(right.X, 0, right.Z)
    if forward.Magnitude <= 0.001 or rightFlat.Magnitude <= 0.001 then
        return
    end

    local moveDirection = (rightFlat.Unit * stick.X) + (forward.Unit * stick.Y)
    if moveDirection.Magnitude > 1 then
        moveDirection = moveDirection.Unit
    end
    humanoid:Move(moveDirection, false)
end)

RunService:BindToRenderStep("ControllerBridge_CustomLook", Enum.RenderPriority.Camera.Value + 1, function(deltaTime)
    if not CONFIG.EnableCustomRightStickLook then
        return
    end

    local stick = state.rightStick
    if stick.Magnitude <= 0 then
        return
    end

    local camera = Workspace.CurrentCamera
    if not camera then
        return
    end

    local yawDelta = -stick.X * CONFIG.LookSensitivityX * deltaTime
    local pitchDelta = -stick.Y * CONFIG.LookSensitivityY * deltaTime
    local position = camera.CFrame.Position
    local rotation = camera.CFrame - position
    local nextRotation = CFrame.Angles(0, yawDelta, 0) * rotation * CFrame.Angles(pitchDelta, 0, 0)
    camera.CFrame = CFrame.new(position) * nextRotation
end)

