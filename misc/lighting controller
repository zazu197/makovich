local function restoreTable(instance, props)
    if not instance then
        return
    end
    for prop, value in pairs(props) do
        if value ~= nil then
            safeSet(instance, prop, value)
        end
    end
end

local function restoreOriginal()
    restoreTable(Lighting, original.Lighting)
    if original.Created.Atmosphere and atmosphere and atmosphere.Parent then
        atmosphere:Destroy()
    else
        restoreTable(atmosphere, original.Atmosphere)
    end
    if original.Created.SunRays and sunRays and sunRays.Parent then
        sunRays:Destroy()
    else
        restoreTable(sunRays, original.SunRays)
    end
    if original.Created.Bloom and bloom and bloom.Parent then
        bloom:Destroy()
    else
        restoreTable(bloom, original.Bloom)
    end
    if original.Created.ColorCorrection and colorCorrection and colorCorrection.Parent then
        colorCorrection:Destroy()
    else
        restoreTable(colorCorrection, original.ColorCorrection)
    end
    resetButton.Text = "Restored"
    task.delay(1.2, function()
        if resetButton and resetButton.Parent then
            resetButton.Text = "Reset captured"
        end
    end)
end

resetButton.MouseButton1Click:Connect(restoreOriginal)

