local function round(value, decimals)
    decimals = decimals or 2
    local mult = 10 ^ decimals
    return math.floor((value * mult) + 0.5) / mult
end

local function clampNumber(value, minValue, maxValue)
    value = tonumber(value) or 0
    if minValue and value < minValue then
        return minValue
    end
    if maxValue and value > maxValue then
        return maxValue
    end
    return value
end

local function safeSet(instance, property, value)
    if not instance then
        return false
    end
    local ok, err = pcall(function()
        instance[property] = value
    end)
    if not ok then
        warn("[LightingTuner] Failed to set " .. tostring(instance.Name) .. "." .. tostring(property) .. ": " .. tostring(err))
    end
    return ok
end

local function safeGet(instance, property)
    if not instance then
        return nil
    end
    local ok, value = pcall(function()
        return instance[property]
    end)
    if ok then
        return value
    end
    return nil
end

local function getOrCreate(className, preferredName)
    local existing = Lighting:FindFirstChild(preferredName)
    if existing and existing.ClassName == className then
        return existing, false
    end
    for _, child in ipairs(Lighting:GetChildren()) do
        if child.ClassName == className then
            return child, false
        end
    end
    local created = Instance.new(className)
    created.Name = preferredName
    created.Parent = Lighting
    return created, true
end

