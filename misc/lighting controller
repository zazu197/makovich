local function colorToRGBText(color)
    color = color or Color3.new(0, 0, 0)
    return math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5)
end

local function createColorControl(section, labelText, defaultColor, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 36)
    row.BackgroundTransparency = 1
    row.Parent = section

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.fromOffset(0, 0)
    label.Size = UDim2.new(0, 122, 1, 0)
    label.Font = Enum.Font.Gotham
    label.Text = labelText
    label.TextColor3 = COLORS.Text
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local swatch = Instance.new("Frame")
    swatch.Position = UDim2.fromOffset(124, 6)
    swatch.Size = UDim2.fromOffset(24, 24)
    swatch.BackgroundColor3 = defaultColor or Color3.new(0, 0, 0)
    swatch.BorderSizePixel = 0
    swatch.Parent = row
    local swatchCorner = Instance.new("UICorner")
    swatchCorner.CornerRadius = UDim.new(0, 6)
    swatchCorner.Parent = swatch

    local boxes = {}
    local labels = {"R", "G", "B"}
    for index, channel in ipairs(labels) do
        local box = Instance.new("TextBox")
        box.Name = channel
        box.Position = UDim2.fromOffset(156 + ((index - 1) * 54), 5)
        box.Size = UDim2.fromOffset(48, 26)
        box.BackgroundColor3 = COLORS.Surface2
        box.BorderSizePixel = 0
        box.ClearTextOnFocus = false
        box.Font = Enum.Font.Gotham
        box.TextColor3 = COLORS.Text
        box.PlaceholderText = channel
        box.PlaceholderColor3 = COLORS.Muted
        box.TextSize = 11
        box.Parent = row
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = box
        boxes[channel] = box
    end

    local function setVisual(color)
        color = color or Color3.new(0, 0, 0)
        local r, g, b = colorToRGBText(color)
        swatch.BackgroundColor3 = color
        if not boxes.R:IsFocused() then boxes.R.Text = tostring(r) end
        if not boxes.G:IsFocused() then boxes.G.Text = tostring(g) end
        if not boxes.B:IsFocused() then boxes.B.Text = tostring(b) end
    end

    local function applyFromBoxes()
        local r = clampNumber(boxes.R.Text, 0, 255)
        local g = clampNumber(boxes.G.Text, 0, 255)
        local b = clampNumber(boxes.B.Text, 0, 255)
        local color = Color3.fromRGB(math.floor(r + 0.5), math.floor(g + 0.5), math.floor(b + 0.5))
        setVisual(color)
        callback(color)
    end

    for _, box in pairs(boxes) do
        box.FocusLost:Connect(applyFromBoxes)
    end

    setVisual(defaultColor)
    table.insert(state.colorControls, { Set = setVisual })
    return { Set = setVisual }
end

